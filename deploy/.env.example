# Copy to .env next to the compose file and fill in. Nothing here has a
# default that fits your setup: every value describes your environment.

# Image published by the CI: ghcr.io/devleesch001/cauri:<tag or latest>,
# or <forgejo host>/<owner>/cauri:<tag> from a Forgejo instance.
CAURI_IMAGE=

# Public host name of cauri, routed by Traefik (no scheme, no path).
CAURI_DOMAIN=

# Traefik: the external Docker network it watches, the entrypoint serving
# HTTPS and the certificate resolver, as named in your Traefik setup.
TRAEFIK_NETWORK=
TRAEFIK_ENTRYPOINT=
TRAEFIK_CERTRESOLVER=

# Database: SQLite, a file in the cauri-data volume. To use your own
# PostgreSQL server instead, set CAURI_DB_DRIVER=postgres and
# CAURI_DB_DSN=postgres://<user>:<password>@<host>:5432/<db>?sslmode=...
CAURI_DB_DRIVER=sqlite
CAURI_DB_DSN=/data/cauri.db

# Optional: MMDB GeoIP database to locate attackers, inside the cauri-data
# volume, such as /data/geoip.mmdb (see the README, GeoIP). Empty: off.
CAURI_GEOIP_DB=
# Optional: MMDB ASN database for the network of attackers, such as
# /data/asn.mmdb (see the README, GeoIP). Empty: off.
CAURI_GEOIP_ASN_DB=
# Password of the administration page (/admin). Empty: a new one is
# generated at each start and written in the API's log.
CAURI_ADMIN_PASSWORD=
# Address or CIDR range of the reverse proxy, such as the Docker network
# Traefik reaches the API on, so that wrong passwords are counted per
# client rather than all as the proxy (see the README, Administration).
# Empty: X-Forwarded-For is ignored.
CAURI_TRUSTED_PROXIES=

# Ingestor ---------------------------------------------------------------
# Identifier of this Cowrie sensor (letters, digits, '.', '_', '-').
CAURI_SENSOR_ID=
# Host directory mounted on Cowrie's /cowrie/cowrie-git/var: it holds
# log/cowrie/cowrie.json and lib/cowrie/tty/. Mounted read-only.
COWRIE_VAR_DIR=
# Host file holding the ingestor token, created with
#   docker compose exec api cauri token create --sensor <CAURI_SENSOR_ID>
CAURI_TOKEN_FILE=
# How the ingestor reaches the API. On the same host, the internal address
# (default) avoids the proxy; a remote sensor uses https://<CAURI_DOMAIN>.
CAURI_INGEST_API_URL=http://api:8080

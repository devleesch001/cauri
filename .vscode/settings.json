{
  // Go: same formatter and linter as the CI.
  "go.lintTool": "golangci-lint-v2",
  "go.lintOnSave": "package",
  "go.testFlags": ["-race"],
  "go.testEnvVars": {
    // Uncomment to run the tests on PostgreSQL too (dev database of
    // deploy/compose.dev.yml, see docs/development.md).
    // "CAURI_TEST_PG_DSN": "postgres://postgres:dev@127.0.0.1:55432/postgres?sslmode=disable"
  },
  "gopls": {
    // ui/ is a separate (empty) module that keeps node_modules out of Go;
    // data/ holds runtime files.
    "build.directoryFilters": ["-ui", "-data"]
  },
  "[go]": {
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": { "source.organizeImports": "explicit" }
  },

  // UI: the project's TypeScript and ESLint, run from ui/.
  "typescript.tsdk": "ui/node_modules/typescript/lib",
  "eslint.workingDirectories": ["ui"],
  "eslint.validate": ["javascript", "typescript", "vue"],
  "[vue]": { "editor.codeActionsOnSave": { "source.fixAll.eslint": "explicit" } },
  "[typescript]": { "editor.codeActionsOnSave": { "source.fixAll.eslint": "explicit" } },

  "files.exclude": {
    "internal/webui/dist/assets": true
  },
  "search.exclude": {
    "ui/node_modules": true,
    "data": true,
    "internal/webui/dist": true
  }
}

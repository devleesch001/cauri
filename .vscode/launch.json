{
  // Debugging. The Go configurations mirror "make dev-api" and
  // "make dev-ingestor" (keep them in sync); run "dev: init" once first.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API (debug)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/cauri",
      "cwd": "${workspaceFolder}",
      "args": ["api", "--log-level", "debug"],
      "env": { "CAURI_LISTEN": ":8090" }
    },
    {
      "name": "Ingestor (debug)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/cauri",
      "cwd": "${workspaceFolder}",
      "args": [
        "ingestor",
        "--api-url", "http://localhost:8090",
        "--token-file", "data/dev.token",
        "--sensor-id", "dev",
        "--cowrie-log-dir", "data/cowrie/log/cowrie",
        "--cowrie-tty-dir", "data/cowrie/lib/cowrie/tty",
        "--state-dir", "data/ingestor",
        "--log-level", "debug"
      ]
    },
    {
      "name": "UI (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/ui",
      "preLaunchTask": "dev: ui"
    }
  ],
  "compounds": [
    {
      "name": "Full stack",
      "configurations": ["API (debug)", "Ingestor (debug)", "UI (Chrome)"],
      "stopAll": true
    }
  ]
}
